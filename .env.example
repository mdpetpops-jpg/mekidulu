# ---------------------------------------------------------------------------
# Mekidulu — environment variables
# Copy to .env.local for development. Values live in Vercel → Settings → Env.
# ---------------------------------------------------------------------------

# Supabase project URL (safe to expose, used by the browser too)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — SERVER ONLY.
# WARNING: the variable name ends with "1" in Vercel. Keep it exact.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY1=

# DeepSeek API key (used by the AI support widget in task 5)
DEEPSEEK_API_KEY=

# Canonical site origin, used for metadata / sitemap / Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
